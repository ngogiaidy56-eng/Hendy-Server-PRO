# Copy to .dev.vars for local development.
# Do not commit .dev.vars. Generate a fresh value for every secret.
BOT_TOKEN=
WEBHOOK_SECRET_TOKEN=
WEBHOOK_SETUP_KEY=

# Optional: fill only if you use these features.
ADMIN_API_TOKEN=
SOCKET_SIGNING_SECRET=
INTERNAL_API_SECRET=
CORE_BACKEND_TOKEN=

# Optional HTTPS URL override. Leave blank to use the current Worker hostname.
TELEGRAM_WEBHOOK_URL=

# Optional: defaults to the production Worker hostname.
WORKER_BASE_URL=https://hendy-server-pro.ngogiaidy56.workers.dev

# Non-secret Worker variables are configured in wrangler.toml / Dashboard:
# ADMIN_IDS=123456789
# MEDIA_ALLOWED_HOSTS=youtube.com,youtu.be,tiktok.com,facebook.com,fb.watch
# CORE_BACKEND_URL=https://your-vietsub-backend.example
