# Copy to .dev.vars for local development. Never commit .dev.vars.
# Use independent, newly generated values for every secret.
BOT_TOKEN=
WEBHOOK_SECRET_TOKEN=
WEBHOOK_SETUP_KEY=
ADMIN_API_TOKEN=
SOCKET_SIGNING_SECRET=
INTERNAL_API_SECRET=
CORE_BACKEND_TOKEN=

# Optional HTTPS override. When empty, Worker host is used automatically.
# Example: TELEGRAM_WEBHOOK_URL=https://bot.example.com/webhook
TELEGRAM_WEBHOOK_URL=

# Non-secret Worker variables:
# CORE_BACKEND_URL=https://your-vietsub-backend.example
# ADMIN_IDS=123456789
# MEDIA_ALLOWED_HOSTS=youtube.com,youtu.be,tiktok.com,facebook.com,fb.watch
